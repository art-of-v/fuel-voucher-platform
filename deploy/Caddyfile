# Caddy reverse proxy for FuelFlow.
#
# Caddy automatically requests and renews free HTTPS certificates from Let's Encrypt
# for the two domains below. Requirements for that to work:
#   1. DNS A records for both domains must already point at this server's IP
#   2. Ports 80 and 443 must be open in the firewall
# Certificates are stored in the `caddy_data` Docker volume, so they survive restarts.
#
# ROOT_DOMAIN / API_DOMAIN / ACME_EMAIL come from deploy/.env.production via docker-compose.
{
	email {$ACME_EMAIL}
}

# Headers applied to both sites. Kept in one snippet so the two sites cannot drift.
#
#   Strict-Transport-Security  - Caddy redirects http->https, but without HSTS the FIRST
#                                request of a session is still cleartext and strippable.
#                                `preload` is deliberately omitted: it is a hard-to-reverse
#                                commitment for every current and future subdomain.
#   X-Content-Type-Options     - stops a browser from sniffing a JSON/text response as HTML,
#                                which is how a reflected value becomes stored XSS.
#   X-Frame-Options /
#   frame-ancestors            - no clickjacking of the admin dashboard.
#   Referrer-Policy            - keeps full URLs (which contain voucher and order GUIDs)
#                                out of the Referer header sent to third parties.
#   Permissions-Policy         - neither site needs camera/mic/geolocation.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# Endpoints that must exist (Prometheus scraping, the Hangfire job dashboard) but
# have no business being reachable from the public internet. Denied here at the edge
# as defense in depth: the backend already has no published ports, so this survives
# any future change to the compose networking. Import in a site block, or inside a
# `route` block to preserve order.
(internal_only) {
	@metrics path /metrics /metrics/*
	respond @metrics 404

	@hangfire path /hangfire /hangfire/*
	respond @hangfire 404
}

# --- Admin dashboard (React SPA) ---
# The nginx inside admin-frontend also proxies /api to the backend, so the dashboard
# talks to the API on its own origin.
#
# That same-origin proxy previously republished the ENTIRE API on this domain: the
# Monobank webhook, the device-signed mobile checkout, every mobile endpoint. Two public
# front doors to one money API means every future per-domain control (WAF rule, IP
# allow-list, Cloudflare policy) has to be remembered twice, and the second door is the
# one that gets forgotten.
#
# The allow-list below is derived from the admin SPA's own source - these are the only
# /api paths it calls (grep for fetch/axios paths under admin/src). Anything else under
# /api on this domain answers 404 and never reaches the backend. Mobile clients and
# Monobank use {$API_DOMAIN}, which is unchanged.
#
# Trailing-slash and case variants that miss the allow-list fall through to the SPA's
# index.html rather than the backend, so a near-miss fails closed. When adding an admin
# feature that calls a new endpoint, add it here or it will 404 in production only.
{$ROOT_DOMAIN} {
	import security_headers

	header {
		# No inline scripts in the built bundle (verified against admin/dist/index.html),
		# so script-src needs no 'unsafe-inline'. Styles do: Tailwind and React both emit
		# inline style attributes, and the Google Fonts stylesheet is cross-origin.
		# connect-src is 'self' (the SPA calls a relative "/api") PLUS Sentry's ingest host:
		# @sentry/react POSTs error events cross-origin to *.ingest.de.sentry.io, so without
		# this the browser blocks every event and admin error tracking silently never works.
		# The host is region-specific (this project is in Sentry's EU/Frankfurt region) and a
		# wildcard, not the org-specific DSN host, so no account id leaks into the repo. When
		# ADMIN_SENTRY_DSN is unset the SDK never loads and this allowance simply goes unused.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://*.ingest.de.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	encode zstd gzip

	@admin_api path /api/admin /api/admin/* /api/auth/refresh /api/auth/refresh/logout /api/auth/admin/send-code /api/auth/admin/verify /api/auth/two-factor/verify /api/auth/user/me /api/voucher-catalog/import
	@any_api path /api /api/*

	# `route` preserves the written order; without it Caddy would sort these by its own
	# specificity rules and the deny could end up after the catch-all.
	# Upstreams are named by the prod CONTAINER name, never by the service name. Both stacks run
	# on this box and Caddy is attached to fuelflow_shared, where staging joins under the SAME
	# service-name aliases (`admin-frontend`, `website-frontend`, `fuelflow-backend`). Caddy is
	# therefore on both networks with one name meaning two containers, and which one a lookup
	# returns decides what production serves.
	#
	# Observed on 2026-10-11: api.palne.shop answered 400 "Invalid Hostname" for every request,
	# because the lookup had landed on the staging backend, whose AllowedHosts has no
	# api.palne.shop. The admin SPA was exposed to the same coin flip. A prod container name is
	# registered on no other network, so it resolves to exactly one container - and if it is ever
	# wrong, it fails loudly with a 502 instead of silently serving the other stack.
	route {
		import internal_only
		reverse_proxy @admin_api fuelflow-admin:5000
		respond @any_api 404
		reverse_proxy fuelflow-admin:5000
	}
}

# --- Public API (mobile app + Monobank webhooks) ---
{$API_DOMAIN} {
	import security_headers

	encode zstd gzip

	# This origin serves JSON to a native app and to Monobank. It has no legitimate
	# browser UI, so the strictest possible policy applies: a response that somehow
	# renders as HTML can load nothing at all.
	#
	# Consequence to know about: the Hangfire dashboard at /hangfire is HTML and will
	# not render under this policy. It is already unreachable from a browser - the API
	# authenticates with JWT bearer tokens only, so a browser navigation arrives
	# unauthenticated and HangfireDashboardAuthorizationFilter answers 403. Use an SSH
	# tunnel to the container if you need it.
	#
	# One exception: /api/auth/email/confirm is the single HTML page this origin renders —
	# the emailed email-change confirmation landing. It is self-contained (inline <style>
	# and the lion inlined as a data: URI), so that path alone needs style-src 'unsafe-inline'
	# and img-src data:. Mutually-exclusive matchers keep default-src 'none' on every other
	# response, and even the confirm page still gets no scripts and no remote resource of any kind.
	@email_confirm path /api/auth/email/confirm /api/auth/email/confirm/
	@api_default {
		not path /api/auth/email/confirm /api/auth/email/confirm/
	}
	header @email_confirm Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header @api_default Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	import internal_only

	reverse_proxy fuelflow-backend:8080
}

# --- LEMBERG-FUEL.CORP static marketing site ---
# Served by the website-frontend container (nginx running the Next.js static
# export built from the repo's website/ on every deploy - same pipeline as the
# admin dashboard; nothing is hand-copied to the host any more).
#
# The support page posts to the API directly from the browser, so this domain
# needs one allow-listed API path - exactly like the admin domain above. The
# form's API origin is configured at build time via NEXT_PUBLIC_API_URL.
palne.shop, www.palne.shop {
	encode zstd gzip

	# Deliberately NOT the admin security_headers snippet: its CSP assumes a Vite
	# bundle with no inline scripts and same-origin-only fetches. Next.js inlines
	# its hydration payload in <script> tags (needs script-src unsafe-inline) and
	# the support form fetches the API cross-origin (needs connect-src api domain),
	# so the admin CSP would break the page and the form. This lighter set keeps
	# the transport-level headers both sites share.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Nothing on these pages is meant to be framed: there is no form a third party
		# could prefill by embedding them, so refusing costs nothing.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Public contact form (palne.shop/support). Rate-limited in the API
	# (5/h/IP named policy) and honeypot-guarded; CORS on the API must
	# include this origin for the browser POST to pass.
	@support_api path /api/support/messages
	@any_api path /api /api/*

	route {
		reverse_proxy @support_api fuelflow-backend:8080
		respond @any_api 404
		reverse_proxy fuelflow-website:5001
	}
}

# ============================================================================
# STAGING (same box) — docker-compose.staging.yml
#
# Every staging.* domain sits behind HTTP Basic auth. That gate is what makes it
# safe to run the auth surface on staging with the prod-only startup guards
# relaxed (ASPNETCORE_ENVIRONMENT=Staging: payments off, OTP to logs). A leaked
# Basic credential is not a full compromise: DevBypass stays off and payments are
# disabled on staging.
#
# Upstreams are the staging containers, reached over the shared `fuelflow_shared`
# network under the aliases staging-admin / fuelflow-staging-backend / staging-website
# (the prod caddy service joins that network in docker-compose.prod.yml).
#
# Routing MIRRORS the three prod blocks above on purpose, so staging exercises the
# same allow-lists prod does — keep them in sync when you touch either. All three
# vhosts are INERT until the STAGING_* / STAGING_BASICAUTH_* env vars are set in
# deploy/.env.production; the deploy runs `caddy validate` first, so an unset var fails the
# deploy loudly instead of restarting caddy with a broken config.
#
# STAGING_BASICAUTH_HASH is a bcrypt hash from `caddy hash-password`, and it is
# read from deploy/.env.production - caddy is the production service, so "STAGING_" here
# means "the staging vhosts prod's caddy fronts", not a variable .env.staging owns.
#
# Every `$` in the hash is doubled to `$$` so compose collapses it back to `$`;
# caddy un-doubles it when it reads the env var. Measured on the box: compose
# passes a lone `$` through unchanged, so a partially escaped hash still collapses
# into a valid one and still works. The hazard is a value that is not a hash at
# all - caddy then reads it as base64-encoded plaintext and refuses to start.
# See docs/ROTATION.md (private docs repo) and deploy/preflight.sh.
# ============================================================================

# --- Staging admin dashboard ---
{$STAGING_ROOT_DOMAIN} {
	import security_headers
	basic_auth {
		{$STAGING_BASICAUTH_USER} {$STAGING_BASICAUTH_HASH}
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://*.ingest.de.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	encode zstd gzip

	@admin_api path /api/admin /api/admin/* /api/auth/refresh /api/auth/refresh/logout /api/auth/admin/send-code /api/auth/admin/verify /api/auth/two-factor/verify /api/auth/user/me /api/voucher-catalog/import
	@any_api path /api /api/*

	route {
		import internal_only
		reverse_proxy @admin_api staging-admin:5000
		respond @any_api 404
		reverse_proxy staging-admin:5000
	}
}

# --- Staging API (mobile app + Monobank webhooks) ---
{$STAGING_API_DOMAIN} {
	import security_headers
	basic_auth {
		{$STAGING_BASICAUTH_USER} {$STAGING_BASICAUTH_HASH}
	}

	encode zstd gzip

	# Same /api/auth/email/confirm exception as the prod API block above — keep in sync.
	@email_confirm path /api/auth/email/confirm /api/auth/email/confirm/
	@api_default {
		not path /api/auth/email/confirm /api/auth/email/confirm/
	}
	header @email_confirm Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header @api_default Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	import internal_only

	reverse_proxy fuelflow-staging-backend:8080
}

# --- Staging marketing site ---
{$STAGING_MARKETING_DOMAIN} {
	basic_auth {
		{$STAGING_BASICAUTH_USER} {$STAGING_BASICAUTH_HASH}
	}

	encode zstd gzip

	# Same lighter header set as the prod marketing block (Next.js needs inline scripts;
	# the admin CSP would break the page and the support form).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	@support_api path /api/support/messages
	@any_api path /api /api/*

	route {
		reverse_proxy @support_api fuelflow-staging-backend:8080
		respond @any_api 404
		reverse_proxy staging-website:5001
	}
}
