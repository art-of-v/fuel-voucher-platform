# ------------------------------------------------------------------------------
# FuelFlow STAGING environment — TEMPLATE
#
# Copy to ".env.staging" ON THE BOX (gitignored, like .env):
#     cp .env.staging.example .env.staging
#     nano .env.staging
#
# Staging is a SECOND, fully isolated stack on the same server (its own DB, redis,
# JWT secret and domains). It shares only the prod Caddy, which fronts every staging
# domain with HTTP Basic auth. Generate strong secrets with:  openssl rand -base64 36
# ------------------------------------------------------------------------------


# === STAGING DOMAINS ==========================================================
# Each needs its own DNS "A" record pointing at the SAME server IP as prod, added
# BEFORE the stack starts, or Caddy cannot issue HTTPS certificates for them.
#   ROOT_DOMAIN      -> staging admin dashboard
#   API_DOMAIN       -> staging API
#   MARKETING_DOMAIN -> staging marketing site
# No "https://" and no trailing slash. (Same variable NAMES as prod .env — they just
# live in this separate file with staging values.)
ROOT_DOMAIN=staging-app.palne.shop
API_DOMAIN=staging-api.palne.shop
MARKETING_DOMAIN=staging.palne.shop


# === DATABASE (staging Postgres — separate from prod) =========================
# Different credentials from prod on purpose: a staging leak must not touch prod.
POSTGRES_DB=fuelflow_staging
POSTGRES_USER=fuelflow_staging
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_36


# === REDIS ====================================================================
# HEX (a "/" breaks the app's Redis parsing):  openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32


# === JWT SIGNING KEY ==========================================================
# Its OWN secret (>=32 chars), distinct from prod, so staging tokens are never valid
# against prod and vice versa.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string


# === PAYMENTS (Monobank) — OFF by default =====================================
# Staging must never take a real charge. Left off, the payment flow is disabled.
# To exercise it, set MONOBANK_ENABLED=true and supply Monobank SANDBOX credentials
# (never the live merchant token).
MONOBANK_ENABLED=false
MONOBANK_TOKEN=
MONOBANK_PUBLIC_KEY=
# MONOBANK_BASE_URL=https://api.monobank.ua


# === SMS (login codes) — optional on staging ==================================
# Unset => FakeSmsService: OTP codes go to the container log only. Read them with
#   docker logs fuelflow-staging-backend
# Set real SMS Club creds here only if you want codes delivered to phones on staging.
SMSCLUB_TOKEN=
SMSCLUB_SENDER_NAME=


# === OPTIONAL =================================================================
# Bootstrap ProductOwner (E.164), QA test-access code — usually left blank on staging.
BOOTSTRAP_PRODUCT_OWNER_PHONE=
AUTH_QA_TEST_ACCESS_CODE=

# Support-form email: unset => delivery off, submissions still persist to the DB.
SUPPORT_MAIL_USERNAME=
SUPPORT_MAIL_PASSWORD=
SUPPORT_MAIL_TO_EMAIL=

# Voucher expiry: false on staging so it can test against expired stock.
VOUCHER_EXPIRATION_ENABLED=false

# Observability: off by default to spare RAM and keep prod's telemetry clean. Set a
# separate staging Loki/Sentry project here if you want staging telemetry.
LOKI_ENABLED=false
SENTRY_DSN=

# OTA (self-hosted Expo Updates): unset => /api/updates/manifest answers 204 (no update).
# Point it at a public R2 base URL only to exercise OTA on staging (docs/DEPLOYMENT.md).
OTA_PUBLIC_BASE_URL=
