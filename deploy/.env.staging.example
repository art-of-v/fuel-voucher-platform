# ------------------------------------------------------------------------------
# FuelFlow STAGING environment — TEMPLATE
#
# Copy to ".env.staging" ON THE BOX (gitignored, like .env.production):
#     cp .env.staging.example .env.staging
#     nano .env.staging
#
# Staging is a SECOND, fully isolated stack on the same server (its own DB, redis,
# JWT secret and domains). It shares only the prod Caddy, which fronts every staging
# domain with HTTP Basic auth. Generate strong secrets with:  openssl rand -base64 36
#
# Every value below must be filled in. The stack refuses to start with blanks - and it
# refuses to start on a PLACEHOLDER as well: the values in this file are instructions,
# not secrets, and this repository is public until 2026-11-01, so a value that was never
# replaced is a value everybody has. Staging is on the same host as production, so its
# keys are worth the same as production's.
# ------------------------------------------------------------------------------


# === STAGING DOMAINS ==========================================================
# Each needs its own DNS "A" record pointing at the SAME server IP as prod, added
# BEFORE the stack starts, or Caddy cannot issue HTTPS certificates for them.
#   ROOT_DOMAIN      -> staging admin dashboard
#   API_DOMAIN       -> staging API
#   MARKETING_DOMAIN -> staging marketing site
# No "https://" and no trailing slash. (Same variable NAMES as prod .env — they just
# live in this separate file with staging values.)
ROOT_DOMAIN=staging-app.palne.shop
API_DOMAIN=staging-api.palne.shop
MARKETING_DOMAIN=staging.palne.shop


# === DATABASE (staging Postgres — separate from prod) =========================
# Different credentials from prod on purpose: a staging leak must not touch prod.
POSTGRES_DB=fuelflow_staging
POSTGRES_USER=fuelflow_staging
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_36


# === REDIS ====================================================================
# HEX (a "/" breaks the app's Redis parsing):  openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32


# === JWT SIGNING KEY ==========================================================
# Its OWN secret (>=32 chars), distinct from prod, so staging tokens are never valid
# against prod and vice versa. And not the placeholder below: this file is public, so
# the placeholder is a key everybody has.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string


# === OTP PEPPER ===============================================================
# Mixed into every stored verification-code hash (HMAC-SHA256). Left blank, the API
# generates a random pepper for each process: staging keeps working without editing
# this file, but verification codes stop verifying after a restart (they live five
# minutes, and on staging they are read from the log anyway). Set a real value
# (openssl rand -base64 32) if a code must survive a restart.
OTP_PEPPER=


# === OTP DELIVERY CHANNEL ======================================================
# true = the sign-in code rides a free Expo push to the account's registered
# devices. Off by default: staging's fake SMS writes the codes to the container
# log (`docker logs fuelflow-staging-backend`), which is the easy way to sign
# in while testing. Turn on to exercise the push channel; the fake SMS stays
# the fallback for an account with no registered device.
OTP_DELIVERY_VIA_PUSH=false


# === VOUCHER QR CIPHER KEY =====================================================
# Its OWN key (32 bytes, base64), distinct from prod. This one encrypts the redeemable QR
# payload of every voucher at rest, and the key is the ONLY thing that can read it - so a
# staging key that is also a production key means that anyone who reaches staging can
# decrypt production's vouchers. That is why they are separate.
#
# The two are NOT interchangeable afterwards: a payload encrypted with one key cannot be
# read with the other. The staging database holds no vouchers today (measured 2026-10-21:
# zero rows in fuel_vouchers), so nothing had to be re-encrypted when the keys were
# separated. If a production dump is ever restored into staging, the voucher payloads in
# it were encrypted with the PRODUCTION key and cannot be read with this one - either
# re-encrypt them or clear them.
#
#   openssl rand -base64 32
QR_CIPHER_KEY=CHANGE_ME_openssl_rand_base64_32


# === PAYMENTS (Monobank) — OFF by default =====================================
# Staging must never take a real charge. Left off, the payment flow is disabled.
# To exercise it, set MONOBANK_ENABLED=true and supply Monobank SANDBOX credentials
# (never the live merchant token).
MONOBANK_ENABLED=false
# Staging is exempt from the Production boot guard; the switch exists here only so the
# two env files keep the same shape.
MONOBANK_ACKNOWLEDGE_DISABLED_IN_PRODUCTION=false
MONOBANK_TOKEN=
MONOBANK_PUBLIC_KEY=
# Comma-separated E.164 numbers routed to the sandbox merchant. Everything else is routed to the
# live merchant - which staging must never do, so keep MONOBANK_TOKEN empty here and put the sandbox
# credentials below instead.
MONOBANK_QA_PHONES=
MONOBANK_SANDBOX_TOKEN=
# MONOBANK_BASE_URL=https://api.monobank.ua


# === SMS (login codes) — optional on staging ==================================
# Unset => FakeSmsService: OTP codes go to the container log only. Read them with
#   docker logs fuelflow-staging-backend
# Set real SMS Club creds here only if you want codes delivered to phones on staging.
SMSCLUB_TOKEN=
SMSCLUB_SENDER_NAME=
# How long the SMS brand is given to accept the message (the OTP path waits on it).
SMSCLUB_TIMEOUT_SECONDS=10


# === OPTIONAL =================================================================
# Bootstrap ProductOwner (E.164), QA test-access code — usually left blank on staging.
BOOTSTRAP_PRODUCT_OWNER_PHONE=
AUTH_QA_TEST_ACCESS_CODE=

# Support-form email: unset => delivery off, submissions still persist to the DB.
SUPPORT_MAIL_USERNAME=
SUPPORT_MAIL_PASSWORD=
SUPPORT_MAIL_TO_EMAIL=

# === GUARDRAIL SWITCHES =======================================================
# deploy/preflight.sh compares the guarded switches in the live .env.staging with this
# file and refuses to restart on a difference: a git deploy never updates the live file.
# Staging ships one of them - VOUCHER_EXPIRATION_ENABLED is false here so the tier can
# test against expired stock. A deliberate difference goes in the live file as
# ENV_DRIFT_ACKNOWLEDGED="VOUCHER_EXPIRATION_ENABLED" and then warns on every restart.
VOUCHER_EXPIRATION_ENABLED=false

# Observability: off by default to spare RAM and keep prod's telemetry clean. Set a
# separate staging Loki/Sentry project here if you want staging telemetry.
LOKI_ENABLED=false
SENTRY_DSN=

# OTA (self-hosted Expo Updates): unset => /api/updates/manifest answers 204 (no update).
# Point it at a public R2 base URL only to exercise OTA on staging (docs/DEPLOYMENT.md (private docs repo)).
OTA_PUBLIC_BASE_URL=
# How long the CDN is given to answer (an installed app's update check waits on it).
OTA_TIMEOUT_SECONDS=15
