# ------------------------------------------------------------------------------
# FuelFlow production environment — TEMPLATE
#
# Copy this to ".env" ON THE DROPLET (never commit the real .env — it's gitignored):
#     cp .env.production.example .env
#     nano .env
#
# Every value below must be filled in. The stack refuses to start with blanks - and it
# refuses to start on a PLACEHOLDER as well. The values in this file are instructions,
# not secrets: this repository is public until 2026-11-01, so a value that was never
# replaced is a value everybody has. The JWT key below signs every access token, so a
# placeholder one lets anybody forge a staff token. deploy/preflight.sh refuses it
# before the deploy, and the API refuses to boot on it.
# Generate strong random secrets with:
#     openssl rand -base64 36
# ------------------------------------------------------------------------------


# === DOMAINS ==================================================================
# All of them need a DNS "A" record pointing at your server's IP before you
# start the stack, otherwise HTTPS certificates can't be issued.
#   ROOT_DOMAIN      -> the admin dashboard  (e.g. app.example.com)
#   API_DOMAIN       -> the API the mobile app, admin and Monobank call
#                       (e.g. api.example.com)
#   MARKETING_DOMAIN -> the static palne.shop site; its support form POSTs to
#                       the API, so the API must know this host name.
# Do NOT include "https://" or a trailing slash.
ROOT_DOMAIN=app.example.com
API_DOMAIN=api.example.com
MARKETING_DOMAIN=palne.shop

# Your email. Let's Encrypt uses it to warn you if a certificate fails to renew.
ACME_EMAIL=you@example.com

# === STAGING VHOSTS (the prod Caddy also terminates TLS for staging) ==========
# The staging stack runs on this box and publishes only on localhost; the prod Caddy
# is the only process that may own :443, so it serves these three domains too. Add
# the A records before the first deploy, or `caddy validate` fails and holds prod.
# Basic auth gates every staging domain. Generate the hash with:
#     docker run --rm caddy:2-alpine caddy hash-password --plaintext 'a-strong-password'
# DOUBLE every $ in the resulting hash (or Compose eats it and login always fails).
# The hash below belongs to a discarded random password: replace it, or nobody can
# sign in to staging.
STAGING_ROOT_DOMAIN=staging-app.example.com
STAGING_API_DOMAIN=staging-api.example.com
STAGING_MARKETING_DOMAIN=staging.example.com
STAGING_BASICAUTH_USER=staging
STAGING_BASICAUTH_HASH=$$2a$$14$$FAdJWMIKpFx3G7l9T0wi7ula./zhHpP.sjBI6LilHWZis3DhbKKkS


# === DATABASE (self-hosted Postgres on this server) ==========================
# POSTGRES_USER is the cluster's SUPERUSER: the operator's credential. The backup, the
# restore and deploy/ensure-database-roles.sh use it. The application never sees it and
# never connects with it.
# The password is only used inside the server, so make it long and forget it.
POSTGRES_DB=fuelflow
POSTGRES_USER=fuelflow
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_36

# --- The roles the application uses ---------------------------------------------
# One role used to serve both the application's traffic and the schema migrations, and
# it was the superuser above - so a defect that reached the database owned the cluster
# instead of leaking a table. There are three now, and none of them is a superuser:
#
#   fuelflow_app          the application's traffic: exactly the privileges the matrix
#                         in deploy/database-privileges.tsv gives it. The audit and
#                         ledger tables are insert-only for it and the retention tables
#                         cannot be deleted by it. It cannot change the schema, create a
#                         role, create a database, or bypass row-level security.
#   fuelflow_migrator     the schema: it may change the tables and nothing else.
#   fuelflow_maintenance  the nightly retention purge: DELETE and SELECT on exactly the
#                         tables the matrix hands it, and no INSERT or UPDATE anywhere.
#
# The passwords below are GENERATED by deploy/ensure-database-roles.sh when they are
# missing, and written back into this file - so the deploy does not stop on a box whose
# .env predates this change. Set them by hand if you prefer:
#     openssl rand -base64 32
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_MAINTENANCE_PASSWORD=
# Optional: a SELECT-only role for the reporting and support queries somebody runs by
# hand. Without a password here the role is not created.
POSTGRES_READONLY_PASSWORD=

# The connection to this database VERIFIES the server's certificate, so the server needs one.
# There is nothing to set here: the deploy job runs deploy/ensure-postgres-tls.sh, which
# creates the certificate authority and the server certificate in deploy/certs/postgres/ and
# keeps the CA across deploys. The connection string is in docker-compose.prod.yml
# ("SSL Mode=Verify Full;Root Certificate=/certs/ca.crt"), and the application refuses to
# boot in production if it says anything else - the session carries the money and the
# personal data, so the other side has to prove who it is.
#
# If the certificate is lost, the database will not start until the script has run again -
# and a NEW CA means the connection string's Root Certificate has to point at the new one.


# === REDIS ====================================================================
# Use HEX here, not base64: a "/" in this password breaks the app's Redis
# connection parsing. Generate with:  openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32


# === JWT SIGNING KEY ==========================================================
# MUST be at least 32 characters or the API will not start - and it must NOT be the
# placeholder below: this file is public, so the placeholder is a key everybody has, and
# an access token signed with it can be forged by anybody.
# Changing this later logs everyone out — that's fine, just expected.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string


# === OTP PEPPER ===============================================================
# Mixed into every stored verification-code hash (HMAC-SHA256), and the API will NOT
# start in Production without it. A six-digit code hashed with a bare SHA-256 is a
# million-guess search from a leaked database; this value is the half of the key that
# never reaches the database, so a dump alone cannot test a candidate.
# Changing it invalidates every code in flight - they live five minutes, so that is
# safe. Generate one with:
#     openssl rand -base64 32
OTP_PEPPER=CHANGE_ME_openssl_rand_base64_32


# === QR CIPHER KEY (D-14) ======================================================
# Encrypts `fuel_vouchers.qr_payload` on write; the API will NOT start without it
# (docker-compose.prod.yml requires it with `:?`).
#
# THIS KEY IS THE DATABASE. It was missing from this file until 2026-10-19, which
# meant a fresh box - or a disaster-recovery restore performed by following this
# file - could not start the API at all, and nothing said why.
#
# Losing it is not "losing a day": every voucher QR becomes permanently
# unreadable, so a restored database has no redeemable fuel in it. Keep it in a
# password manager, NOT only on the server - the same manager that holds the age
# backup key. The server holds a copy so it can serve normal traffic; that copy is
# not a backup of the key.
#
# Staging has its OWN key, in .env.staging. It used to share this one, which meant that
# anyone who reached staging could decrypt production's vouchers - and staging is behind
# an HTTP Basic credential, on the same host. The keys are separate since 2026-10-21, and
# the two are not interchangeable: a payload encrypted with one cannot be read with the
# other.
#     openssl rand -base64 32
QR_CIPHER_KEY=CHANGE_ME_openssl_rand_base64_32


# === APP ATTESTATION (Apple App Attest / Play Integrity) ======================
# Production runs report-only: every proof that is present is verified and logged,
# but a missing or invalid proof never blocks a request. Old builds keep working
# while the fleet is measured. The API refuses to start in Production while this is
# not enforcing unless ACKNOWLEDGE_DISABLED... is true, because "off" must be a
# recorded decision rather than an omission.
#
# This is the checked-in production default. The live .env is not updated by a git
# deploy: set the same values on the droplet and restart the backend. Do not set
# Mode=Enforce until the real-device test in the runbook passes; iOS is the first
# platform, and Android stays out until it is installed from Play.
ATTESTATION_ENABLED=true
ATTESTATION_MODE=ReportOnly
ATTESTATION_ACKNOWLEDGE_DISABLED_IN_PRODUCTION=true
# Android only, after the package is in Play and the Google Cloud project exists.
# This is the service-account JSON, not the project number. Keep it in the server
# secret store, never in git. Minify the JSON to one line for this file (the
# private_key's newlines are already \n escapes). Setting it is safe in report-only:
# it lets the backend verify Android proofs and log Valid instead of GOOGLE_NOT_CONFIGURED.
# ATTESTATION_GOOGLE_CREDENTIALS_JSON=


# === PRODUCT OWNER (single super-admin) =======================================
# The one ProductOwner is defined HERE, not created in the app — the ProductOwner
# role is not assignable through the admin panel by anyone, and there is only ever
# one. On boot the API promotes this phone to ProductOwner if that account exists
# (idempotent; a no-op once it already is). Leave blank to skip the bootstrap.
# Full E.164 format, e.g. +380XXXXXXXXX.
BOOTSTRAP_PRODUCT_OWNER_PHONE=


# === SMS (login codes) ==========================================================
# At least one provider must be configured, otherwise the API refuses to start
# in Production (the dev login bypass is switched off).
#
# The channel a sign-in code rides on, tried in order:
#  1. PUSH, when OTP_DELIVERY_VIA_PUSH=true below: a free Expo push to the
#     account's own registered devices (any phone signed into the app once).
#     SMS stays the fallback for an account with no active device token or a
#     push Expo rejects, so nobody is locked out. Flip this on when the SMS
#     balance runs out.
#  2. SMS (SMS Club below) - the default channel.
#  3. EMAIL break-glass, staff only, for the day the SMS gateway is down:
#     needs Auth__AdminOtpViaEmailBreakGlassAcknowledged=true as well, and
#     every use is audited. A decision, not a setting - do not leave it on.
#
OTP_DELIVERY_VIA_PUSH=false
#
# SMS Club (primary — cheaper UA delivery). Register at https://my.smsclub.mobi,
# get the JSON API token from the "JSON Profile" section, and register + approve
# the alpha-name (SenderName) in your cabinet.
SMSCLUB_TOKEN=
SMSCLUB_SENDER_NAME=
# How long the SMS brand is given to accept the message. The OTP path waits on it, so a brand
# that never answers must not hold a login for the hundred seconds HttpClient allows by default.
SMSCLUB_TIMEOUT_SECONDS=10

# === QA App-Store test access ===================================================
# Verification code for the dedicated QA test account (phone +380110010203), used
# for Apple App Store review sign-in. Treat this as a production credential:
#   - It is hashed once at startup; the plaintext is never stored, logged, or
#     returned by any API.
#   - Leaving it BLANK keeps QA sign-in permanently disabled no matter what — the
#     fail-safe default. Only set it when App Review needs access.
#   - Setting it is NOT enough on its own: an admin must also switch "QA Test
#     Access" ON in the admin panel (Settings). Switching it OFF there immediately
#     revokes any live QA session. No app/backend release is needed to toggle it.
#   - Rotate by changing this value and restarting the API.
AUTH_QA_TEST_ACCESS_CODE=


# === MONOBANK (real payments) =================================================
# MONOBANK_TOKEN      - your merchant API token
# MONOBANK_PUBLIC_KEY - the webhook-signature public key (base64/PEM string).
#                       The API refuses to start if this is empty or a placeholder.
#
# Second merchant, used ONLY by QA accounts so they can run the whole payment path
# (redirect -> webhook -> fulfilment) while production takes real money. It sits beside
# the live credentials and is never removed: a QA checkout that reached the live
# merchant would take real money from someone who is testing.
# MONOBANK_SANDBOX_TOKEN - sandbox merchant API token
# MONOBANK_QA_PHONES      - comma-separated E.164 numbers allowed to use the sandbox,
#                               e.g. +380501234567,+380501234568
#
# Not required to boot. With the sandbox unset, QA accounts are refused at checkout
# rather than quietly charged on the live merchant - which is the failure this exists
# to prevent.
# Reminder: after going live, also set the webhook URL to
#           https://<API_DOMAIN>/api/monobank/webhook
#           inside the Monobank merchant dashboard. Setting it here is not enough.
MONOBANK_TOKEN=
MONOBANK_PUBLIC_KEY=
MONOBANK_SANDBOX_TOKEN=
MONOBANK_QA_PHONES=


# === VOUCHER-EXPIRATION GATE ===================================================
# Refuses to sell stock whose expiry date has passed. Leave true: turning it off
# means the most-expired voucher in the pool is handed to the next buyer, and the
# only thing that notices is the customer's own app. This flag has no admin
# surface, so it is read once at startup - change it with a restart.
VOUCHER_EXPIRATION_ENABLED=true
# Turning the gate off in Production (while MONOBANK is enabled) now refuses to
# boot until you also set this to true, which is what turns the exception into a
# recorded decision. The sandbox sets it deliberately to keep testing against
# expired stock. Remove it the moment real money is taken.
VOUCHER_EXPIRATION_ACKNOWLEDGE_DISABLED_IN_PRODUCTION=false


# === OKKO PUMP-PRICE SYNC ======================================================
# Once a day at 03:05 the API reads the current pump price from the OKKO site and
# reprices packages, so the price shown to customers matches the column at the pump.
# It does NOT touch the supplier cost - that is what you paid and stays manual.
# Leave false until the supplier costs are consistent: any fuel whose pump price
# sits below its recorded cost becomes unsellable (checkout refuses the fuel type).
OKKO_PRICE_ENABLED=false

# UPG and WOG publish their price list as a page rather than an API, so the backend reads the
# sheet itself. Same failure policy as the OKKO fetch: a page that cannot be read leaves the
# last known prices alone. The catalogue half of these jobs runs weekly, so a new grade appears
# on the week rather than the quarter.
UPGWOG_PRICE_ENABLED=false

# KLO publishes no prices of its own, so Minfin's table is the source: the average retail price
# of every network, KLO included. Its five grades are the five our KLO catalogue holds.
MINFIN_PRICE_ENABLED=false

# Where Monobank sends the customer after paying. The deep link below reopens
# the mobile app; leave it as-is unless you changed the app's URL scheme.
MONOBANK_REDIRECT_URL=fuelflow://payment-result


# === SUPPORT FORM EMAIL (palne.shop/support) ==================================
# Submissions from the support page are emailed to SUPPORT_MAIL_TO_EMAIL
# (palne.shopua@gmail.com in production) via SMTP.
#
# For Gmail: enable 2FA on the account, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) and use
# those 16 characters as SUPPORT_MAIL_PASSWORD. The regular account password
# is always rejected by Google's SMTP servers.
#
# Leave USERNAME and PASSWORD empty to disable delivery - submissions are then
# only stored in the support_messages database table (nothing is lost, but
# nobody gets an email).
SUPPORT_MAIL_HOST=smtp.gmail.com
SUPPORT_MAIL_PORT=587
SUPPORT_MAIL_USERNAME=palne.shopua@gmail.com
SUPPORT_MAIL_PASSWORD=
SUPPORT_MAIL_TO_EMAIL=palne.shopua@gmail.com


# === OBSERVABILITY (optional stack, deploy/docker-compose.observability.yml) ========
# Prometheus + Loki + Grafana on the same server. Grafana is reachable ONLY through
# an SSH tunnel (127.0.0.1:3000), but still give it a real admin password:
#     openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=

# Dedicated HTTP Basic credential used only for application -> Loki ingestion.
# The gateway accepts POST /loki/api/v1/push and rejects every query endpoint.
# Use a stable non-secret username and generate a strong password:
#     openssl rand -base64 32
LOKI_PUSH_USERNAME=fuelflow-api
LOKI_PUSH_PASSWORD=

# Telegram alerts (optional overlay: docker-compose.observability.telegram.yml).
# 1. Telegram -> @BotFather -> /newbot -> copy the token.
# 2. Create a private group, add the bot, post any message into it.
# 3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates" and read
#    result[].chat.id (a negative number).
# Leave empty to run the base stack without alert delivery.
# The nightly backup's failure alert (deploy/notify-backup-failure.sh) reuses this
# same bot/chat, so a failed backup lands in the same group as "app is down".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# === FEEDBACK BOT (in-app Telegram feedback channel, optional) ==================
# A SEPARATE bot from the alerting one above: Telegram allows exactly one webhook
# per bot token, and a flooded or misrouted feedback webhook must never be able to
# silence a low-stock alert.
# 1. Telegram -> @BotFather -> /newbot, name it something obviously not-alerts.
# 2. Create a PRIVATE group for the team, add the bot, PROMOTE IT TO ADMIN (Telegram
#    privacy mode otherwise hides staff replies from it, which silently kills the
#    two-way half of the feature).
# 3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates" for the group chat id
#    (negative), and /getMe for the @username.
# 4. WebhookSecret: 1-16 chars of A-Za-z0-9_-. Telegram echoes it back on every
#    delivery; it is the only credential the webhook has.
#    openssl rand -hex 8
# 5. SigningKey: at least 16 bytes, signs the /start payload that binds a chat to a
#    customer account. Rotating it invalidates every outstanding deep link.
#    openssl rand -hex 32
# 6. StaffUserIds: the Telegram user ids allowed to relay an answer to a customer.
#    Group membership alone is deliberately not enough.
# 7. Set TELEGRAM_FEEDBACK_ENABLED=true above and restart the API.
# 8. In the admin panel -> Settings -> "In-app feedback": tick "Enable the feedback
#    channel" (the FeedbackBot:Enabled app_setting - the mobile tab stays hidden
#    without it, and this is the switch to flip to take the channel out of service
#    without a redeploy) and press "Register webhook". The URL is taken from the
#    address you are browsing the admin panel on, so do it against the real domain -
#    registering from localhost points Telegram at your own machine.
#    The same card shows whether Telegram has the webhook and any error it reported,
#    so you can confirm it worked without a terminal.
# Re-run step 8 after any deploy or domain change; the webhook URL has to match.
TELEGRAM_FEEDBACK_ENABLED=false
TELEGRAM_FEEDBACK_BOT_TOKEN=
TELEGRAM_FEEDBACK_BOT_USERNAME=
TELEGRAM_FEEDBACK_WEBHOOK_SECRET=
TELEGRAM_FEEDBACK_SIGNING_KEY=
TELEGRAM_FEEDBACK_STAFF_CHAT_ID=
TELEGRAM_FEEDBACK_STAFF_USER_IDS=
# === Telegram settlement bot (closed finance channel, optional) ====================
# A separate bot token from the two above: one webhook per token. Finance posts
# "<amount> <settlement code>" here (e.g. 1500 K7P2M4XB) and the API turns a
# matching message into a payment, attaching it to an open order when the amount
# is unambiguous. Messages are always audited in settlement_messages.
# Set TELEGRAM_SETTLEMENT_ENABLED=true AND fill token + secret + chat id + user ids.
# TELEGRAM_SETTLEMENT_CHAT_ID is NEGATIVE for a group (e.g. -1001234567890).
# TELEGRAM_SETTLEMENT_ALLOWED_USER_IDS is comma-separated (144799809,123456789).
# The user ids are the real security boundary: the webhook secret only proves
# Telegram sent the delivery. Leaving this empty makes the bot accept NOTHING.
# Register the webhook with setWebhook only after the deploy is live, and on the
# API_DOMAIN host, not the admin one.
TELEGRAM_SETTLEMENT_ENABLED=false
TELEGRAM_SETTLEMENT_BOT_TOKEN=
TELEGRAM_SETTLEMENT_WEBHOOK_SECRET=
TELEGRAM_SETTLEMENT_CHAT_ID=
TELEGRAM_SETTLEMENT_ALLOWED_USER_IDS=
# === LLM (feedback triage, optional) ============================================
# Decides whether a feedback message carries information or is a greeting/joke.
# Leave BLANK: every message is still collected and stored, it is just not filtered.
# Key from Google AI Studio (free tier is enough at our volume).
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash


# === SENTRY (error tracking, optional) ==========================================
# The backend's Sentry DSN. Leave BLANK and Sentry is never initialised — the app
# runs exactly as before and sends nothing off-box. To turn it on, create a (free)
# project at sentry.io, copy its DSN here, and restart the backend:
#     cd /root/FuelFlow/deploy && docker compose -f docker-compose.prod.yml up -d fuelflow-backend
# The DSN is a write-only ingest key, not a account secret, but it is kept out of git
# like every other value here. Request bodies and PII are never sent (the API carries
# phone numbers and voucher QR payloads); only errors and stack traces are.
SENTRY_DSN=

# The admin SPA's Sentry DSN — a SEPARATE Sentry project from the backend (browser
# JavaScript vs .NET). Unlike SENTRY_DSN this is baked into the static bundle at BUILD
# time (the admin is nginx serving files, with no runtime env), so a change here only
# takes effect on the next deploy/rebuild, not a restart. Leave BLANK and the admin
# never initialises Sentry. Create a second "Browser React" project at sentry.io for it.
ADMIN_SENTRY_DSN=


# === OVER-THE-AIR UPDATES (OTA — self-hosted Expo Updates, optional) ============
# Public, CDN-fronted base URL of the Cloudflare R2 bucket that serves the mobile
# app's signed JS updates (a SEPARATE public bucket from the private backup remote
# below — e.g. https://ota.palne.shop). Each manifest is pre-signed on the Mac publish
# machine (mobile/scripts/publish-ota.mjs) and this API only relays the signed bytes,
# so the private signing key never lives on the server. Leave BLANK and
# /api/updates/manifest answers 204 (no update available) — the feature is inert and
# every installed app just keeps its current bundle. Setup + publish runbook:
# docs/DEPLOYMENT.md (private docs repo) ("Over-the-air updates (OTA)").
OTA_PUBLIC_BASE_URL=
# How long the CDN is given to answer. An installed app asking "is there an update?" waits on
# it, so a CDN that never answers is a 502 on the update check.
OTA_TIMEOUT_SECONDS=15


# === BACKUPS (deploy/backup.sh, scheduled by deploy/systemd/fuelflow-backup.timer) ===
# The nightly encrypted database backup. Install the schedule once with:
#     sudo /root/FuelFlow/deploy/install-backup-schedule.sh
#
# BACKUP_AGE_RECIPIENT is REQUIRED — backup.sh refuses to write an unencrypted dump.
# Generate the keypair on your LAPTOP (never here), keep the private key off this box:
#     age-keygen -o fuelflow-backup.key      # store in a password manager
# and paste the printed "age1..." public key below.
BACKUP_AGE_RECIPIENT=

# Off-server copy (STRONGLY recommended — a backup only on the server it backs up is
# not a backup). An rclone remote pointing at Cloudflare R2, configured once on the box
# with `rclone config` (see docs/DEPLOYMENT.md (private docs repo) "Off-site backups (Cloudflare R2)").
# Leave empty and the dump stays on-box only (backup.sh warns loudly on every run).
#     BACKUP_REMOTE=r2:fuelflow-backups
BACKUP_REMOTE=

# Optional overrides — the defaults are fine for the standard single-box layout.
# RETENTION_DAYS                how many days of local dumps to keep    (default 14)
# BACKUP_REMOTE_RETENTION_DAYS  how many days to keep off-site in R2     (default 30)
# BACKUP_DIR                    where encrypted dumps are written        (default /root/fuelflow-backups)
# CONTAINER                     the postgres container to pg_dump from    (default fuelflow-postgres)
RETENTION_DAYS=14


# === WAL ARCHIVE (point-in-time recovery) =======================================
#
# The archive is what makes a restore possible at a moment in time, and it is also
# the fastest-growing thing on this disk. Two bounds apply, and the SIZE one is the
# guarantee:
#
#   WAL_RETENTION_DAYS   the POLICY - how long the archive stays on the box. Short on
#                        purpose: the off-box copy is a complete nightly snapshot, so
#                        the history lives there and the on-box copy only has to
#                        bridge the gap between two snapshots.
#   WAL_MAX_BYTES        the GUARD - whatever rate the archive turns out to grow at,
#                        it cannot pass this cap. A full disk is how Postgres stops
#                        accepting writes, and this is what makes that impossible.
#
# Measured on the production box on 2026-10-20: 74 segments and 1.06 GiB in 11h15m -
# 0.0942 GiB/h, about 2.26 GiB/day. At that rate the 8 GiB cap is reached in about
# three and a half days.
#
# The trim runs from two places, on purpose:
#   - deploy/prune-wal-archive.sh, called by backup.sh BEFORE it writes anything, so
#     the disk is freed first;
#   - the same script on its own six-hourly timer (fuelflow-wal-prune.timer), so the
#     bound holds even on a night when the backup itself fails.
#
# You do not normally need to change any of these. If you do, change them HERE and
# not in the script: both the backup and the timer read this file.
#
# WAL_RETENTION_DAYS=3
# WAL_MAX_BYTES=8589934592
# WAL_ARCHIVE_DIR=/root/fuelflow-wal
# STAGING_WAL_ARCHIVE_DIR=/root/fuelflow-wal-staging
# STAGING_WAL_MAX_BYTES=1073741824
# DISK_ALERT_THRESHOLD=85
