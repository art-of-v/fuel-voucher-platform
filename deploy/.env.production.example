# ------------------------------------------------------------------------------
# FuelFlow production environment — TEMPLATE
#
# Copy this to ".env" ON THE DROPLET (never commit the real .env — it's gitignored):
#     cp .env.production.example .env
#     nano .env
#
# Every value below must be filled in. The stack refuses to start with blanks.
# Generate strong random secrets with:
#     openssl rand -base64 36
# ------------------------------------------------------------------------------


# === DOMAINS ==================================================================
# All of them need a DNS "A" record pointing at your server's IP before you
# start the stack, otherwise HTTPS certificates can't be issued.
#   ROOT_DOMAIN      -> the admin dashboard  (e.g. app.example.com)
#   API_DOMAIN       -> the API the mobile app, admin and Monobank call
#                       (e.g. api.example.com)
#   MARKETING_DOMAIN -> the static palne.shop site; its support form POSTs to
#                       the API, so the API must know this host name.
# Do NOT include "https://" or a trailing slash.
ROOT_DOMAIN=app.example.com
API_DOMAIN=api.example.com
MARKETING_DOMAIN=palne.shop

# Your email. Let's Encrypt uses it to warn you if a certificate fails to renew.
ACME_EMAIL=you@example.com


# === DATABASE (self-hosted Postgres on this server) ==========================
# The password is only used inside the server, so make it long and forget it.
POSTGRES_DB=fuelflow
POSTGRES_USER=fuelflow
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_36


# === REDIS ====================================================================
# Use HEX here, not base64: a "/" in this password breaks the app's Redis
# connection parsing. Generate with:  openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32


# === JWT SIGNING KEY ==========================================================
# MUST be at least 32 characters or the API will not start.
# Changing this later logs everyone out — that's fine, just expected.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string


# === SMS (login codes) ==========================================================
# At least one provider must be configured, otherwise the API refuses to start
# in Production (the dev login bypass is switched off).
#
# Admins (Role = "Admin") receive their sign-in code by EMAIL instead of a paid
# SMS, reusing the SUPPORT_MAIL_* SMTP account further down. It falls back to SMS
# whenever email is unconfigured, the account has no email, or a send fails, so an
# SMS provider is still required. Set Auth__AdminOtpViaEmail=false to force SMS.
#
# SMS Club (primary — cheaper UA delivery). Register at https://my.smsclub.mobi,
# get the JSON API token from the "JSON Profile" section, and register + approve
# the alpha-name (SenderName) in your cabinet.
SMSCLUB_TOKEN=
SMSCLUB_SENDER_NAME=
#
# Twilio (fallback). Copy from console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890


# === MONOBANK (real payments) =================================================
# MONOBANK_TOKEN      - your merchant API token
# MONOBANK_PUBLIC_KEY - the webhook-signature public key (base64/PEM string).
#                       The API refuses to start if this is empty or a placeholder.
# Reminder: after going live, also set the webhook URL to
#           https://<API_DOMAIN>/api/monobank/webhook
#           inside the Monobank merchant dashboard. Setting it here is not enough.
MONOBANK_TOKEN=
MONOBANK_PUBLIC_KEY=

# Where Monobank sends the customer after paying. The deep link below reopens
# the mobile app; leave it as-is unless you changed the app's URL scheme.
MONOBANK_REDIRECT_URL=fuelflow://payment-result


# === SUPPORT FORM EMAIL (palne.shop/support) ==================================
# Submissions from the support page are emailed to SUPPORT_MAIL_TO_EMAIL
# (palne.shopua@gmail.com in production) via SMTP.
#
# For Gmail: enable 2FA on the account, then create an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) and use
# those 16 characters as SUPPORT_MAIL_PASSWORD. The regular account password
# is always rejected by Google's SMTP servers.
#
# Leave USERNAME and PASSWORD empty to disable delivery - submissions are then
# only stored in the support_messages database table (nothing is lost, but
# nobody gets an email).
SUPPORT_MAIL_HOST=smtp.gmail.com
SUPPORT_MAIL_PORT=587
SUPPORT_MAIL_USERNAME=palne.shopua@gmail.com
SUPPORT_MAIL_PASSWORD=
SUPPORT_MAIL_TO_EMAIL=palne.shopua@gmail.com


# === OBSERVABILITY (optional stack, deploy/docker-compose.observability.yml) ========
# Prometheus + Loki + Grafana on the same server. Grafana is reachable ONLY through
# an SSH tunnel (127.0.0.1:3000), but still give it a real admin password:
#     openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=

# Dedicated HTTP Basic credential used only for application -> Loki ingestion.
# The gateway accepts POST /loki/api/v1/push and rejects every query endpoint.
# Use a stable non-secret username and generate a strong password:
#     openssl rand -base64 32
LOKI_PUSH_USERNAME=fuelflow-api
LOKI_PUSH_PASSWORD=

# Telegram alerts (optional overlay: docker-compose.observability.telegram.yml).
# 1. Telegram -> @BotFather -> /newbot -> copy the token.
# 2. Create a private group, add the bot, post any message into it.
# 3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates" and read
#    result[].chat.id (a negative number).
# Leave empty to run the base stack without alert delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
