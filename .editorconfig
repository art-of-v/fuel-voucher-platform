# EditorConfig - https://editorconfig.org
#
# One style for the whole repository, so that two editors produce the same file and a diff
# shows what changed rather than how the author's editor happened to be configured.
#
# The rules here state what the tree already does, so nothing below is a reformat in
# disguise:
#   * LF line endings - .gitattributes normalises to LF, and the mobile CI job runs
#     Prettier, whose `endOfLine: lf` treats a CRLF file as unformatted (see the comment
#     in .gitattributes: it cost PR #955).
#   * UTF-8, spaces, no tabs, a final newline.
#   * Two spaces of indentation everywhere except C#, which uses four.
#
# Two of these rules are NOT advisory, because the tool behind them reads this file:
#   * Prettier (mobile) reads indent_size, indent_style, end_of_line and max_line_length,
#     so the TypeScript section below matches mobile/.prettierrc.json EXACTLY -
#     printWidth 100 included. A different number here would silently change what
#     `npm run format:check` accepts and turn the gate red on files nobody touched.
#   * The C# options are read by the IDE (and by `dotnet format`). They are left at
#     `suggestion` severity on purpose: `EnforceCodeStyleInBuild` is off, so a style
#     preference can never fail the build.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4
tab_width = 4

# The C# conventions the codebase already follows: file-scoped namespaces, System usings
# first, Allman braces, no `this.`.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_preserve_single_line_blocks = true
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = true:suggestion

[*.{ts,tsx,js,jsx,mjs,cjs,json}]
# Prettier's own settings (mobile/.prettierrc.json): tabWidth 2, printWidth 100, LF.
# The width has to match exactly - Prettier reads it from here, and a different number
# would make `npm run format:check` disagree with the files it was written for.
indent_size = 2
max_line_length = 100

[*.md]
# Two trailing spaces are a line break in Markdown, so they are content, not noise.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[*.{yml,yaml,json,xml,csproj,props,targets}]
indent_size = 2

[Makefile]
indent_style = tab
