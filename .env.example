# Copy to .env and fill in. Used by docker-compose.yml.
POSTGRES_DB=fuel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
MONOBANK_API_TOKEN=
MONOBANK_WEBHOOK_URL=
# Encrypts the voucher QR payload at rest. Required in every environment; the app
# refuses to start without it. Must decode to exactly 32 bytes for AES-256:
#   openssl rand -base64 32
# Losing this key loses every voucher QR permanently - it is not in the database.
QrCipher__Key=