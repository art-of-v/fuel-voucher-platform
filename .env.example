# Copy to .env and fill in. Used by docker-compose.yml.
#
# Every value the compose file passes to a container comes from here. The ones the application
# refuses to start without carry a `:?` guard in the compose file, so a missing value is a loud
# error while the file is parsed rather than a crash-loop discovered later.
POSTGRES_DB=fuel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Monobank is OFF by default: the local stack ships the in-process mock, so checkout works
# without a merchant account. Set this to true only together with a token and a public key -
# with the integration on and no credentials, every checkout fails at the acquirer.
MONOBANK_ENABLED=false
MONOBANK_API_TOKEN=
MONOBANK_PUBLIC_KEY=
MONOBANK_WEBHOOK_URL=

# Encrypts the voucher QR payload at rest. Required in every environment; the app refuses to
# start without it. Must decode to exactly 32 bytes for AES-256:
#   openssl rand -base64 32
# Losing this key loses every voucher QR permanently - it is not in the database.
QrCipher__Key=
