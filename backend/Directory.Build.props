<Project>

  <!--
    The build settings every project in this repository shares, in one place.

    There are five projects (the API, the standalone jobs worker and three test projects).
    Until this file existed each of them repeated the same two lines, and the settings
    that only make sense repository-wide - how strict the build is, whether the NuGet
    graph may float - had nowhere to live at all.

    The SDK is pinned in global.json and the editor conventions in .editorconfig, both at
    the repository root; the resolved package graph is in one packages.lock.json per
    project (see below).

    WHY THIS FILE IS IN backend/ AND NOT AT THE ROOT. MSBuild finds it by walking up
    from the project directory, so either place would do for a local build - but the
    image build's context is backend/ (`docker build -f backend/src/FuelFlow.API/
    Dockerfile ... backend`), and a file at the repository root is not inside that
    context at all. A root props file is invisible to the image build, and the first
    version of this change proved it: the image build compiled without the implicit
    usings and failed on `IServiceCollection` and `WebApplication` - in a job that
    runs only after the merge, so nothing on the pull request would have shown it.
    Here it is one level down, where every project and the image build can both see it.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <!--
      The C# conventions in .editorconfig are IDE preferences. Enforcing them in the build
      would fail a build over a brace placement, which is how a style rule becomes the
      reason nobody can merge.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      TreatWarningsAsErrors stays OFF, and that is a decision rather than an omission.

      Measured on 2026-10-21: the API project alone builds with 39 warnings - 10 of them
      the NuGet advisories for SixLabors.ImageSharp 2.1.13, whose only fix is a major
      version bump that the voucher-import path does not warrant (the accepted risk is
      written down in .github/workflows/ci.yml), and the rest nullable and style
      warnings spread over files this change does not touch. Flipping the flag on today
      would turn every unrelated pull request red and hand the next session a build
      repair instead of a feature.

      What IS promoted are the warnings that mean a mistake rather than a preference:
      an unreachable statement, a variable or field that is never used, a task that is
      started and never awaited, and a NuGet graph that does not resolve to what was
      asked for. The codebase satisfies all of them today, and they are the ones worth
      never seeing again.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0162;CS0168;CS0169;CS0219;CS4014</WarningsAsErrors>
    <!--
      The accepted risk above, named here so that turning TreatWarningsAsErrors on later
      is a one-line change instead of a red build nobody can explain.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The resolved dependency graph, committed next to every project as packages.lock.json.

      Without it, a transitive dependency can change under a build that changed nothing:
      the direct PackageReference says the same thing, but the version of a package it
      pulls in is chosen at restore time. The lock file records the whole graph, so the
      same commit restores the same packages everywhere.

      The lock file is generated by `dotnet restore` and must be committed WITH the change
      that moved a version. In CI the restore is locked (below), so a version bump without
      the regenerated lock file fails the build with NU1004 and says what to run.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">
    <!--
      A CI build must restore exactly what the lock file says, and fail rather than
      quietly re-resolve. A developer build does not: there the lock file is updated in
      place, which is what makes the usual "bump a package, commit the lock file" flow
      work without ceremony.
    -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

</Project>
