<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      The reviewed baseline for test-only warnings (planning #687). EF1002/EF1003 flag raw SQL
      built with string interpolation or concatenation. In this suite those strings are test
      fixtures against a throwaway PostgreSQL container: table names, constraint names and
      literal ids that EF cannot parameterise (a parameterised table name is still not a table
      name), and no value comes from user input. The warnings that were NOT in this family were
      fixed rather than baselined. Owner: Artem. Removal date: 2027-01-31, when the fixtures
      that build identifiers move to quoted literals or Npgsql parameters.
    -->
    <NoWarn>$(NoWarn);EF1002;EF1003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 asks for EF Core Relational 10.0.4, but
         FuelFlow.API resolves that same package to 10.0.12 - so without this pin the test project
         compiles against a DIFFERENT Relational assembly than the code under test was built with,
         which MSBuild reports as MSB3277 on every build. Pinned here, not in Npgsql, because the
         API's graph is the one that has to match. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.15.0" />
    <!-- FF-33: Testcontainers 4.12.0 pulls SSH.NET 2025.1.0 transitively, which is affected by
         GHSA-q939-rpr3-3284 / CVE-2026-48798 (SCP recursive-download path traversal, high).
         Not reachable from this suite - Testcontainers never performs an SCP directory download -
         but pinned forward to the first patched release to keep `dotnet build` and `nuget audit`
         clean rather than carrying a known-vulnerable package. Remove this pin once
         Testcontainers.PostgreSql ships a version that resolves SSH.NET >= 2026.0.0 itself. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FuelFlow.API\FuelFlow.API.csproj" />
  </ItemGroup>

  <!-- The fixed clock the suite runs on. One copy, shared with the other two test projects, so
       the three suites cannot drift apart on what "now" means. See the file for why the clock
       exists at all (planning finding C-10). -->
  <ItemGroup>
    <Compile Include="..\Shared\TestClock.cs" Link="Shared\TestClock.cs" />
  </ItemGroup>

  <!-- Real supplier PDFs (sanitised - see TestData/SupplierPdfs/README.md). Copied to the output
       directory so a fixture test can load it by relative path. -->
  <ItemGroup>
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>