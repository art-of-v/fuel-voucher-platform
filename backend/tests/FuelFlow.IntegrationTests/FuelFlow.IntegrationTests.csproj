<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <!-- FF-33: Testcontainers 4.12.0 pulls SSH.NET 2025.1.0 transitively, which is affected by
         GHSA-q939-rpr3-3284 / CVE-2026-48798 (SCP recursive-download path traversal, high).
         Not reachable from this suite - Testcontainers never performs an SCP directory download -
         but pinned forward to the first patched release to keep `dotnet build` and `nuget audit`
         clean rather than carrying a known-vulnerable package. Remove this pin once
         Testcontainers.PostgreSql ships a version that resolves SSH.NET >= 2026.0.0 itself. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FuelFlow.API\FuelFlow.API.csproj" />
    <ProjectReference Include="..\..\src\FuelFlow.JobsWorker\FuelFlow.JobsWorker.csproj">
      <Aliases>JobsWorker</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>