{
  "Database": {
    "ConnectionString": "Server=localhost;Port=49153;User ID=postgres;Password=postgrespw;Database=fuelFlow;"
  },
  // Alloy only scrapes Docker containers, so a host-run worker would otherwise send no logs
  // to Loki at all. Pointing the sink at the compose stack keeps local logs searchable.
  "Observability": {
    "Loki": {
      "Enabled": true,
      "Url": "http://localhost:3100"
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "Username": "admin",
    "Password": "dev123"
  },
  // Alerts raised by the worker itself. Separate from Grafana's metric-based alerts,
  // which read TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID from backend/.env instead.
  //
  // This file is committed - do NOT paste a real bot token here. Use user-secrets:
  //   dotnet user-secrets set "Telegram:BotToken" "123456:ABC-your-token"
  //   dotnet user-secrets set "Telegram:ChatIds:0" "-1001234567890"
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatIds": [],
    "MinimumSeverity": "Warning",
    // The worker only raises voucher and fulfillment events; the user, company,
    // payment, import and exception toggles live in the API's config.
    "Notifications": {
      "Vouchers": {
        "NotifyOnLowStock": false,
        "NotifyOnZeroStock": false,
        "NotifyOnOrderUnfulfillable": false,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  }
}