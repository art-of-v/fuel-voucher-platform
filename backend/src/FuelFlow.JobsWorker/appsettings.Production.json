{
  // DEPLOYMENT: override with the real database via Database__ConnectionString.
  // The value below is a placeholder and its credentials are not usable.
  "Database": {
    "ConnectionString": "Host=postgres;Port=5432;Database=fuelflow;Username=postgres;Password=postgres"
  },
  // DEPLOYMENT: the dashboard can enqueue and delete jobs. Change the password via
  // Hangfire__Password and keep port 9091 off the public internet.
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "Username": "admin",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // DEPLOYMENT: values below are intentionally empty and must be supplied.
  //
  // This file is committed to git, so secrets must NOT be written here. Set them
  // as environment variables instead ("__" is the section separator):
  //
  //   Telegram__Enabled=true
  //   Telegram__BotToken=123456:ABC-your-token
  //   Telegram__ChatIds__0=-1001234567890
  //
  // These are alerts the worker raises itself. Grafana's metric-based alerts are a
  // separate path configured via backend/.env, so both need setting up.
  // See docs/DEPLOYMENT.md.
  // ---------------------------------------------------------------------------
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatIds": [],
    "MinimumSeverity": "Warning",
    // The worker only raises voucher and fulfillment events; the user, company,
    // payment, import and exception toggles live in the API's config.
    "Notifications": {
      "Vouchers": {
        "NotifyOnLowStock": false,
        "NotifyOnZeroStock": false,
        "NotifyOnOrderUnfulfillable": false,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  },

  "Observability": {
    "Environment": "Production",
    "StructuredLogs": true,
    // Leave disabled if Alloy scrapes the container's stdout, otherwise every log
    // line is stored twice. Enable only if the app must push to Loki directly.
    "Loki": {
      "Enabled": false,
      "Url": "http://loki:3100"
    }
  }
}
