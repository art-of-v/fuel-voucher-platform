<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FuelFlow.IntegrationTests" />
    <InternalsVisibleTo Include="FuelFlow.UnitTests" />
    <!-- CatalogueTestData lives here so three test projects share one seeding helper instead of
         keeping three copies that drift. See the type for the full reasoning. -->
    <InternalsVisibleTo Include="FuelFlow.Brands.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Branded transactional-email lion, embedded so it ships inside the assembly and is loaded as a
         cid: linked resource (see EmailBrand). Explicit LogicalName keeps the lookup name stable. -->
    <EmbeddedResource Include="SharedKernel\Notifications\Email\Assets\fuelflow-lion.png">
      <LogicalName>FuelFlow.Email.fuelflow-lion.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.1.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.18.0-rc.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="9.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    
    <!-- Shared packages from Application and Infrastructure -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Hangfire.Core 1.8.25 pulls Newtonsoft.Json 11.0.1 transitively (it serializes
         background-job arguments and state), which is affected by GHSA-5crp-9r3c-p9vr - a
         StackOverflow/DoS on deeply nested JSON during deserialization (high). Pin forward to
         the patched 13.x so the vulnerable serializer never resolves: in the shipped API and
         JobsWorker images, and - via NuGet version unification - in every test project that
         references them (clears the NU1903 build warning). Hangfire 1.8.x supports
         Newtonsoft.Json 13.x. Remove this pin once Hangfire.Core resolves Newtonsoft.Json
         >= 13 itself. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.ImageSharp.V2" Version="0.16.20" />

    <!-- Observability: metrics, traces, structured logs, health checks -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="9.0.5" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.11.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />

    <!-- Transitive today, pinned here because it is not safe to leave alone. Resolves in through
         Microsoft.IdentityModel.* 8.19.2 at 10.0.0, which two advisories published 2026-10-13 cover:
         CVE-2026-84008 (High, CVSS 7.5) - SignedCms.CheckSignature reparses attacker-controlled
         X.509 in quadratic time; CVE-2026-70162 (Moderate, 5.9, Windows) - EnvelopedCms.Decode
         does the same on CMS attributes. Both are fixed in 10.0.13.

         Nothing in this codebase calls either API, so neither path is reachable today - the X.509
         we do handle is Monobank's webhook key, and nothing decodes CMS. That is a reason not to
         lose sleep, not a reason to stay on a version with a published DoS in it: the next person to
         add a certificate path should not inherit this.

         Unlike the ImageSharp advisories the CI gate accepts, this is a patch bump inside the same
         major, so there is nothing to weigh against - just move. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

    <!-- Customer documents (per-order receipt, #119). QuestPDF ships no fonts of its own, so PT Sans
         is embedded below - see SharedKernel/Pdf/PdfFonts.cs for why the document must not depend on
         the host's fonts. -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

</Project>
