{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // host.docker.internal is required so the Prometheus container can scrape the API
  // running on the host. Without it host filtering rejects the scrape with a 400 and
  // the target sits permanently down. Development only - production keeps its own list.
  "AllowedHosts": "localhost;127.0.0.1;10.0.2.2;host.docker.internal",
  // Alloy only scrapes Docker containers, so a host-run API would otherwise send no logs
  // to Loki at all. Pointing the sink at the compose stack keeps local logs searchable.
  "Observability": {
    "Loki": {
      "Enabled": true,
      "Url": "http://localhost:3100"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=fuel_db_dotnet;Username=postgres;Password=postgres;SSL Mode=Disable;Trust Server Certificate=true;"
  },
  "Auth": {
    "DevBypass": true
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5001"]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FuelFlow",
    "Audience": "FuelFlow",
    "AccessTokenExpirationMinutes": 200,
    "RefreshTokenExpirationDays": 14
  },
  "Monobank": {
    "Token": "",
    "WebhookUrl": "",
    "BaseUrl": "https://api.monobank.ua",
    "PublicKey": "",
    "Enabled": true,
    "RedirectUrl": "fuelflow://payment-result"
  },
  "DeviceAuth": {
    "Enabled": true,
    "ChallengeExpirySeconds": 30,
    "SignatureNonceTtlSeconds": 300,
    "TimestampToleranceMs": 300000,
    "AllowDevelopmentBypass": true,
    "RequireSignatureForEndpoints": [
      "/api/purchases",
      "/api/purchases/bulk"
    ]
  },
  // Alerts raised by the application itself. Separate from Grafana's metric-based
  // alerts, which read TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID from backend/.env instead.
  //
  // This file is committed - do NOT paste a real bot token here. To try it locally:
  //   dotnet user-secrets set "Telegram:BotToken" "123456:ABC-your-token"
  //   dotnet user-secrets set "Telegram:ChatIds:0" "-1001234567890"
  "Telegram": {
    "Enabled": true,
    "BotToken": "",
    "ChatIds": [],
    // Only affects alerts that are NOT explicit domain events; the per-event toggles
    // below are their own gate and bypass this floor.
    "MinimumSeverity": "Warning",
    "Notifications": {
      "NotifyOnNewUser": true,
      "NotifyOnCompanyCreated": true,
      "NotifyOnPaymentSuccess": true,
      "NotifyOnPaymentFailure": true,
      "NotifyOnImportErrors": true,
      "NotifyOnUnhandledException": true,
      "ExceptionThrottleMinutes": 15,
      "Vouchers": {
        "NotifyOnLowStock": true,
        "NotifyOnZeroStock": true,
        "NotifyOnOrderUnfulfillable": true,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  }
}