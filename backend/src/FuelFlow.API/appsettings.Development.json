{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // host.docker.internal is required so the Prometheus container can scrape the API
  // running on the host. Without it host filtering rejects the scrape with a 400 and
  // the target sits permanently down. Development only - production keeps its own list.
  "AllowedHosts": "localhost;127.0.0.1;10.0.2.2;host.docker.internal",
  // The Loki sink FAILS CLOSED: enabled without credentials, the composition root throws at
  // startup ("Observability:Loki:Username and Password are required when the Loki sink is
  // enabled"). A development environment has no credentials, so the sink is off - and with it
  // off the application boots, which is what BOTH local paths need: `dotnet run` from this
  // directory and the container in the root docker-compose.yml. It was on here, which meant
  // neither of them started.
  //
  // To push to a Loki of your own, set Observability__Loki__Enabled=true together with
  // Observability__Loki__Username and Observability__Loki__Password - the environment overrides
  // this file.
  "Observability": {
    "Loki": {
      "Enabled": false,
      "Url": "http://localhost:3100"
    }
  },
  "Database": {
    // The SAME database the compose stack creates - the values from `.env.example`
    // (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD), reached on the port the compose file
    // publishes. It used to name `fuel_db_dotnet` with the password `postgres`, which was the
    // compose file's OLD hardcoded pair: the container, the API and the healthcheck each named a
    // different database, so a host-run API could not talk to the database the stack had just
    // created. One answer, in one place.
    "ConnectionString": "Host=localhost;Port=5433;Database=fuel_db;Username=postgres;Password=change-me;SSL Mode=Disable;Trust Server Certificate=true;"
  },
  "Auth": {
    "DevBypass": true
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5001"]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FuelFlow",
    "Audience": "FuelFlow",
    "AccessTokenExpirationMinutes": 200,
    "RefreshTokenExpirationDays": 14
  },
  "Monobank": {
    "Token": "",
    "WebhookUrl": "",
    "BaseUrl": "https://api.monobank.ua",
    "PublicKey": "",
    // Off, which is what a dev and a demo environment run (see MonobankClientFactory). With the
    // integration on and no token, every checkout failed at the acquirer - and it failed quietly,
    // because the checkout swallowed the failure and answered with an order that had no payment
    // link. The in-process mock keeps checkout, refund and refund-sync exercisable instead.
    // To pay against the real sandbox, set MONOBANK_ENABLED=true and MONOBANK_TOKEN / MONOBANK_
    // SANDBOX_TOKEN in the environment - the environment overrides this file.
    "Enabled": false,
    "RedirectUrl": "fuelflow://payment-result"
  },
  "DeviceAuth": {
    "Enabled": true,
    "ChallengeExpirySeconds": 30,
    "SignatureNonceTtlSeconds": 300,
    "TimestampToleranceMs": 300000,
    "AllowDevelopmentBypass": true,
    "RequireSignatureForEndpoints": [
      "/api/purchases",
      "/api/purchases/bulk",
      "/api/purchases/renew"
    ]
  },
  // Alerts raised by the application itself. Separate from Grafana's metric-based
  // alerts, which read TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID from backend/.env instead.
  //
  // This file is committed - do NOT paste a real bot token here. To try it locally:
  //   dotnet user-secrets set "Telegram:BotToken" "123456:ABC-your-token"
  //   dotnet user-secrets set "Telegram:ChatIds:0" "-1001234567890"
  "Telegram": {
    "Enabled": true,
    "BotToken": "",
    "ChatIds": [],
    // Only affects alerts that are NOT explicit domain events; the per-event toggles
    // below are their own gate and bypass this floor.
    "MinimumSeverity": "Warning",
    "Notifications": {
      "NotifyOnNewUser": true,
      "NotifyOnCompanyCreated": true,
      "NotifyOnPaymentSuccess": true,
      "NotifyOnPaymentFailure": true,
      "NotifyOnImportErrors": true,
    "NotifyOnUnmatchedRefundSync": true,
      "NotifyOnUnhandledException": true,
      "ExceptionThrottleMinutes": 15,
      "Vouchers": {
        "NotifyOnLowStock": true,
        "NotifyOnZeroStock": true,
        "NotifyOnOrderUnfulfillable": true,
        "NotifyOnExpiringStock": true,
        "NotifyOnFulfillmentRelease": true,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  }
}