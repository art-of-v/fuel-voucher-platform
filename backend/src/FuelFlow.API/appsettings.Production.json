{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "fuel-voucher-platform.onrender.com;fuel-flow-opal.vercel.app;fuelflow.com",
  "Cors": {
    "AllowedOrigins": ["https://fuel-flow-opal.vercel.app"]
  },
  "Auth": {
    "DevBypass": false
  },
  "Jwt": {
    "Issuer": "FuelFlow",
    "Audience": "FuelFlow",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Monobank": {
    "BaseUrl": "https://api.monobank.ua",
    "Enabled": true,
    "RedirectUrl": "https://fuelflow.com/payment-result"
  },
  "DeviceAuth": {
    "Enabled": true,
    "ChallengeExpirySeconds": 30,
    "SignatureNonceTtlSeconds": 300,
    "TimestampToleranceMs": 300000,
    "AllowDevelopmentBypass": false,
    "RequireSignatureForEndpoints": [
      "/api/purchases",
      "/api/purchases/bulk"
    ]
  }
}
