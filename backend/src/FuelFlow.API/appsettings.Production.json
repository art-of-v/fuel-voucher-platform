{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "api.palne.shop;app.palne.shop",
  "Cors": {
    "AllowedOrigins": ["https://app.palne.shop"]
  },
  "Auth": {
    "DevBypass": false,
    "EmailConfirmBaseUrl": "https://api.palne.shop"
  },
  "Jwt": {
    "Issuer": "FuelFlow",
    "Audience": "FuelFlow",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "Monobank": {
    "BaseUrl": "https://api.monobank.ua",
    "Enabled": true,
    "RedirectUrl": "fuelflow://payment-result"
  },
  "DeviceAuth": {
    "Enabled": true,
    "ChallengeExpirySeconds": 30,
    "SignatureNonceTtlSeconds": 300,
    "TimestampToleranceMs": 300000,
    "AllowDevelopmentBypass": false,
    "RequireSignatureForEndpoints": [
      "/api/purchases",
      "/api/purchases/bulk",
      "/api/purchases/renew"
    ]
  },
  "Attestation": {
    // Report-only in production: a proof that is present is verified and logged, but a missing
    // proof does not block an old install. The startup guard still refuses to boot without the
    // acknowledgement until Mode=Enforce, because "not enforcing" must be a recorded decision.
    // The droplet .env can override this (ATTESTATION_ENABLED); the template sets true.
    "Enabled": true,
    "Mode": "ReportOnly",
    "AcknowledgeDisabledInProduction": true,
    "AppleAppId": "TB929MCW58.com.fuelflowmarketplace.www",
    "GooglePackageName": "com.artem.vashchuk.mobileappnative",
    // Enforcement gate: only an iOS build at or above this version is held to the proof. Raise it
    // to the version that actually contains App Attest AFTER that version is live in the store.
    // Android stays out of EnforcePlatforms until the package is in Play and Play Integrity returns
    // a real verdict. Mode must be Enforce for this gate to do anything.
    "MinimumEnforcedAppVersion": "1.2.0",
    "EnforcePlatforms": ["ios"]
  },

  // ---------------------------------------------------------------------------
  // DEPLOYMENT: values below are intentionally empty and must be supplied.
  //
  // This file is committed to git, so secrets must NOT be written here. Set them
  // as environment variables instead ("__" is the section separator):
  //
  //   Telegram__Enabled=true
  //   Telegram__BotToken=123456:ABC-your-token
  //   Telegram__ChatIds__0=-1001234567890
  //
  // Also required, and likewise never committed - see docs/DEPLOYMENT.md (private docs repo):
  //   Database__ConnectionString, Jwt__Secret,
  //   Monobank__Token, Monobank__PublicKey, Monobank__WebhookUrl
  //
  // These are alerts the API raises itself. Grafana's metric-based alerts are a
  // separate path configured via backend/.env, so both need setting up.
  // ---------------------------------------------------------------------------
  "Telegram": {
    // Enabled here, but still a no-op until BotToken + ChatIds arrive from the
    // environment (see comment above and deploy/docker-compose.prod.yml). Those
    // reuse the infra bot's TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID in deploy/.env,
    // so no new secret is needed. IsConfigured = Enabled && BotToken && ChatIds.
    "Enabled": true,
    "BotToken": "",
    "ChatIds": [],
    "MinimumSeverity": "Warning",
    // Each event below can be switched independently. They bypass MinimumSeverity,
    // so the toggle alone decides whether the message is sent.
    "Notifications": {
      "NotifyOnNewUser": false,
      "NotifyOnCompanyCreated": false,
      "NotifyOnPaymentSuccess": false,
      "NotifyOnPaymentFailure": false,
      "NotifyOnImportErrors": true,
      "NotifyOnUnmatchedRefundSync": true,
      // ON. An unhandled exception in production used to be a log line nobody reads. The
      // dispatcher throttles it (15 minutes per exception type + endpoint, below) and the
      // middleware only fires it for a genuine 5xx - a 4xx is the codebase's deliberate
      // validation channel and must not page anybody.
      "NotifyOnUnhandledException": true,
      // Minimum gap between messages for the same exception type + endpoint.
      "ExceptionThrottleMinutes": 15,
      "Vouchers": {
        "NotifyOnLowStock": false,
        "NotifyOnZeroStock": true,
        "NotifyOnOrderUnfulfillable": true,
        // On: stock that is still Available but close to its expiry is invisible to a pool count -
        // it reads as healthy and is worth nothing once the date passes. 14 days matches the
        // renewal trigger threshold, which is when such a voucher becomes worth extending rather
        // than merely aging out.
        "NotifyOnExpiringStock": true,
        "NotifyOnFulfillmentRelease": true,
        "ExpiringWithinDays": 14,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  },

  "Sms": {
    "DailySendLimit": 500
  },
  "SmsClub": {
    "Token": "",
    "SenderName": "",
    "BaseUrl": "https://im.smsclub.mobi"
  },

  "Observability": {
    "Environment": "Production",
    "StructuredLogs": true,
    // Leave disabled if Alloy scrapes the container's stdout, otherwise every log
    // line is stored twice. Enable only if the app must push to Loki directly.
    "Loki": {
      "Enabled": false,
      "Url": "http://loki:3100"
    },
    // Sentry error tracking. The DSN is supplied via the environment
    // (Observability__Sentry__Dsn), never committed. With no DSN the SDK is not
    // initialised, so leaving this empty keeps Sentry fully off.
    "Sentry": {
      "Dsn": "",
      "TracesSampleRatio": 0.0
    }
  }
}
