{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "api.palne.shop;app.palne.shop",
  "Cors": {
    "AllowedOrigins": ["https://app.palne.shop"]
  },
  "Auth": {
    "DevBypass": false
  },
  "Jwt": {
    "Issuer": "FuelFlow",
    "Audience": "FuelFlow",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 14
  },
  "Monobank": {
    "BaseUrl": "https://api.monobank.ua",
    "Enabled": true,
    "RedirectUrl": "fuelflow://payment-result"
  },
  "DeviceAuth": {
    "Enabled": true,
    "ChallengeExpirySeconds": 30,
    "SignatureNonceTtlSeconds": 300,
    "TimestampToleranceMs": 300000,
    "AllowDevelopmentBypass": false,
    "RequireSignatureForEndpoints": [
      "/api/purchases",
      "/api/purchases/bulk"
    ]
  },

  // ---------------------------------------------------------------------------
  // DEPLOYMENT: values below are intentionally empty and must be supplied.
  //
  // This file is committed to git, so secrets must NOT be written here. Set them
  // as environment variables instead ("__" is the section separator):
  //
  //   Telegram__Enabled=true
  //   Telegram__BotToken=123456:ABC-your-token
  //   Telegram__ChatIds__0=-1001234567890
  //
  // Also required, and likewise never committed - see docs/DEPLOYMENT.md:
  //   Database__ConnectionString, Jwt__Secret,
  //   Monobank__Token, Monobank__PublicKey, Monobank__WebhookUrl
  //
  // These are alerts the API raises itself. Grafana's metric-based alerts are a
  // separate path configured via backend/.env, so both need setting up.
  // ---------------------------------------------------------------------------
  "Telegram": {
    // Enabled here, but still a no-op until BotToken + ChatIds arrive from the
    // environment (see comment above and deploy/docker-compose.prod.yml). Those
    // reuse the infra bot's TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID in deploy/.env,
    // so no new secret is needed. IsConfigured = Enabled && BotToken && ChatIds.
    "Enabled": true,
    "BotToken": "",
    "ChatIds": [],
    "MinimumSeverity": "Warning",
    // Each event below can be switched independently. They bypass MinimumSeverity,
    // so the toggle alone decides whether the message is sent.
    "Notifications": {
      "NotifyOnNewUser": false,
      "NotifyOnCompanyCreated": false,
      "NotifyOnPaymentSuccess": false,
      "NotifyOnPaymentFailure": false,
      "NotifyOnImportErrors": true,
      "NotifyOnUnhandledException": false,
      // Minimum gap between messages for the same exception type + endpoint.
      "ExceptionThrottleMinutes": 15,
      "Vouchers": {
        "NotifyOnLowStock": false,
        "NotifyOnZeroStock": false,
        "NotifyOnOrderUnfulfillable": true,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  },

  "Sms": {
    "DailySendLimit": 500
  },
  "SmsClub": {
    "Token": "",
    "SenderName": "",
    "BaseUrl": "https://im.smsclub.mobi"
  },

  "Observability": {
    "Environment": "Production",
    "StructuredLogs": true,
    // Leave disabled if Alloy scrapes the container's stdout, otherwise every log
    // line is stored twice. Enable only if the app must push to Loki directly.
    "Loki": {
      "Enabled": false,
      "Url": "http://loki:3100"
    },
    // Sentry error tracking. The DSN is supplied via the environment
    // (Observability__Sentry__Dsn), never committed. With no DSN the SDK is not
    // initialised, so leaving this empty keeps Sentry fully off.
    "Sentry": {
      "Dsn": "",
      "TracesSampleRatio": 0.0
    }
  }
}
