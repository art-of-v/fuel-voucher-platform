{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;10.0.2.2",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5001"]
  },
  "Database": {
    "ConnectionString": "Host=postgres;Port=5432;Database=fuelflow;Username=postgres;Password=postgres"
  },
  // TODO: remove once staging no longer tests against expired voucher stock.
  "VoucherExpiration": {
    "Enabled": true
  },
  "OkkoPrice": {
    "Enabled": false,
    "EndpointUrl": "https://www.okko.ua/api/uk/fuels",
    "TimeoutSeconds": 30
  },
  "UpgWogPrice": {
    "Enabled": false,
    "UpgEndpointUrl": "https://upg.ua/",
    "WogEndpointUrl": "https://www.wog.ua/ua/fuels/",
    "TimeoutSeconds": 30
  },
  "KloCatalogue": {
    "Enabled": false,
    "EndpointUrl": "https://www.klo.ua/produkty-i-poslugy/",
    "TimeoutSeconds": 30
  },
  "Sms": {
    "DailySendLimit": 500
  },
  "SmsClub": {
    "Token": "",
    "SenderName": "palne.shop",
    "BaseUrl": "https://im.smsclub.mobi"
  },
  "AppVersion": {
    // Hard floor: below this, the app shows an update wall instead of rendering. It must never be
    // higher than the version the stores actually serve - raise it only AFTER that version is live
    // in both stores, not after app.json is bumped. See AppVersionOptions.
    // Raised to 1.1.0 on 2026-10-16, hours after 1.1.0 reached the public App Store. Do not raise it
    // ahead of app.json again: on 2026-10-12 that bricked the app for every user.
    "MinimumVersion": "1.1.0",
    "IosStoreUrl": "https://apps.apple.com/us/app/fuel-flow-marketplace/id6759175079",
    "AndroidStoreUrl": "https://play.google.com/store/apps/details?id=com.artem.vashchuk.mobileappnative"
  },
  "Observability": {
    "ServiceName": "fuelflow-api",
    "Environment": "Development",
    "StructuredLogs": false,
    "Otlp": {
      "Enabled": false,
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc",
      "EnableTraces": false,
      "TraceSampleRatio": 0.1
    },
    "Prometheus": {
      "Enabled": true,
      "WorkerPort": 9091
    },
    "Loki": {
      "Enabled": false,
      "Url": "http://localhost:3100",
      "BatchPostingLimit": 200,
      "QueueLimit": 10000
    },
    "Sentry": {
      "Dsn": "",
      "TracesSampleRatio": 0.0
    }
  },
  "Telegram": {
    "Enabled": false,
    "BotToken": "",
    "ChatIds": [],
    "MinimumSeverity": "Warning",
    "BaseUrl": "https://api.telegram.org",
    "TimeoutSeconds": 10,
    "Feedback": {
      // In-app feedback channel: a private 1-on-1 Telegram chat per customer behind the
      // bottom-bar "Зворотний зв'язок" tab. A SEPARATE bot token from the alerting bot above -
      // Telegram allows one webhook per token, and feedback must never be able to silence a
      // low-stock alert.
      //
      // Turning this on is not enough on its own: the app_settings row FeedbackBot:Enabled
      // must be true too, which is the admin's kill switch - owned by the admin Settings
      // screen, which also reports whether these credentials are present at all and what
      // Telegram thinks of the registered webhook (GET/PUT /api/admin/settings, plus
      // POST /api/admin/settings/feedback/webhook to re-register after a deploy or a
      // domain change - that is the one step you cannot do by hand from this file).
      //
      // The deep-link endpoint answers 404 unless BOTH this switch and the app_settings row
      // are on, and that 404 is what keeps the mobile tab hidden.
      "Enabled": false,
      "BotToken": "",
      // Echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token on every delivery;
      // 1-16 chars of A-Za-z0-9_-. Compared in constant time.
      "WebhookSecret": "",
      // Without the @, used to build https://t.me/{BotUsername}?start={signed payload}.
      "BotUsername": "",
      // Private group that receives triage-passing messages. The bot MUST be an admin of it,
      // otherwise Telegram's privacy mode hides staff replies and the two-way half is dead.
      "StaffChatId": 0,
      // Only these Telegram user ids may relay a reply to a customer. Group membership is
      // deliberately not enough.
      "StaffUserIds": [],
      // HMAC key for the deep-link payload that binds a chat to an account. At least 16 bytes;
      // rotating it invalidates every outstanding deep link, which is the intended kill action.
      "SigningKey": "",
      "DeepLinkTtlDays": 30,
      "MinMessagesPerHour": 10,
      "MaxMessageLength": 2000,
      "MinConfidence": 0.6,
      "BaseUrl": "https://api.telegram.org",
      "TimeoutSeconds": 10
    },
    "Notifications": {
      "NotifyOnNewUser": false,
      "NotifyOnCompanyCreated": false,
      "NotifyOnPaymentSuccess": false,
      "NotifyOnPaymentFailure": false,
      "NotifyOnImportErrors": false,
      "NotifyOnUnhandledException": false,
      "ExceptionThrottleMinutes": 15,
      "Vouchers": {
        "NotifyOnLowStock": false,
        "NotifyOnZeroStock": false,
        "NotifyOnOrderUnfulfillable": false,
        "LowLevelThreshold": 20,
        "ReminderIntervalMinutes": 360
      }
    }
  },
  "ExpoPush": {
    "Enabled": true
  },
  "Llm": {
    // Triage for the feedback bot: decides whether a customer message carries information
    // about the app or is a greeting/joke. With Enabled=false every message is stored and
    // posted to the staff group untriaged, which still collects feedback - it just does not
    // filter it. "Untriaged" means the post carries no category/severity header at all: the
    // classifier has nothing to say, and a placeholder label would only look like an answer.
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-2.0-flash",
    "TimeoutSeconds": 20
  }
}
