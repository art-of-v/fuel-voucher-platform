node_modules/
.expo/
dist/
npm-debug.*
yarn-debug.*
yarn-error.*
.env
.DS_Store
# Native iOS project is generated by `expo prebuild` (CNG) at build time so the
# @sentry/react-native/expo config plugin wires the native Sentry integration
# (sentry.properties + dSYM/source-map upload phases). Do not commit it.
# See art-of-v/fuel-voucher-platform-planning#38. Android stays committed for now.
/ios/

ios/Pods/
ios/build/
android/build/
android/app/*.keystore
*.log

# Local EAS / Apple credentials
secrets/
*.p8
*.p12
*.cer
*.mobileprovision

# EAS Update code-signing private key — NEVER commit. The public certificate in
# certs/ is baked into the build and IS committed; the private key signs update
# manifests at `eas update` time and must stay on the publish machine only.
# See art-of-v/fuel-voucher-platform-planning#42.
keys/
