node_modules/
.expo/
dist/
npm-debug.*
yarn-debug.*
yarn-error.*
.env
.DS_Store
# Native iOS and Android projects are generated by `expo prebuild` (CNG) at build
# time so the config plugins (Sentry native wiring, expo-updates OTA url +
# fingerprint runtimeVersion + code-signing, allowBackup) regenerate native
# config from app.json. Do not commit them.
# See art-of-v/fuel-voucher-platform-planning#38 (iOS) and #5 (Android).
/ios/
/android/

ios/Pods/
ios/build/
android/build/
android/app/*.keystore
*.log

# Local EAS / Apple credentials
secrets/
*.p8
*.p12
*.cer
*.mobileprovision

# EAS Update code-signing private key — NEVER commit. The public certificate in
# certs/ is baked into the build and IS committed; the private key signs update
# manifests at `eas update` time and must stay on the publish machine only.
# See art-of-v/fuel-voucher-platform-planning#42.
keys/
