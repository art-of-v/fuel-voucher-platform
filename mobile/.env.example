# Copy to .env and set per environment. These are optional per-build OVERRIDES: the
# committed app.json (expo.extra.*) already carries the production baseline that every
# build — EAS cloud or a raw Xcode Document Archive — resolves from, so a plain Xcode
# Archive works with no .env at all. Set a value here only to point a local build
# somewhere else.

# Backend origin, https:// with no trailing slash. Unset here, the app uses app.json
# expo.extra.apiUrl (prod); in a dev build it falls back to the local dev host.
EXPO_PUBLIC_API_URL=

# Public basemap key for the price-radar map (CARTO). Unset here, the app uses app.json
# expo.extra.cartoApiKey; empty in both is fine — the map falls back to the native
# basemap with no watermark. Free key (no card, 5M tiles/mo): https://carto.com/
EXPO_PUBLIC_CARTO_API_KEY=
# Google Maps SDK for Android key. NOT exposed to JS: read at config time by app.config.js
# and written into the Android manifest. Without it the map screen CRASHES the app
# (IllegalStateException: API key not found). Get one in Google Cloud ->
# APIs & Services -> Credentials, restricted to the Android package + signing SHA-1.
# iOS needs no key - Apple Maps is used there.
GOOGLE_MAPS_API_KEY=

# Play Integrity project number (not the project id). Read at config time by app.config.js and
# exposed to the app so @expo/app-integrity can prepare the token provider. Unset here or in the
# EAS profile, the Android client sends no Google proof and the backend must not enforce Android.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=

# App Attest entitlement environment. Defaults to "production" in app.config.js so a raw Xcode
# Archive is safe; set "development" only for an Xcode/dev build whose profile carries the
# development App Attest entitlement. EAS sets this per profile in eas.json.
APP_ATTEST_ENVIRONMENT=
