{
  "expo": {
    "name": "FuelFlow",
    "slug": "mobile-app-native",
    "scheme": "fuelflow",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fuelflowmarketplace.www",
      "buildNumber": "206",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Дозвіл на використання Face ID для безпечного доступу до ваших замовлень та проведення транзакцій.",
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps",
          "yandexnavi",
          "here-wego",
          "osmand",
          "osmandplus",
          "organicmaps"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.artem.vashchuk.mobileappnative",
      "versionCode": 1,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      "./plugins/withNavigationQueries.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Дозвольте доступ до геолокації, щоб показати найближчі АЗК та ціни поруч."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "fuelflow",
          "project": "fuelflow-mobile",
          "url": "https://de.sentry.io/"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "37e2ff06-380f-417f-8d19-de2d988c9322"
      },
      "apiUrl": "https://api.palne.shop",
      "sentryDsn": "https://5a29479335684a7e56b5c6eb74f8a9e7@o4512129014628352.ingest.de.sentry.io/4512134845104208",
      "cartoApiKey": "cb1_465z_1_3d4237af93e24d278a489c81"
    },
    "owner": "artem.vashchuk",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "url": "https://api.palne.shop/api/updates/manifest",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
