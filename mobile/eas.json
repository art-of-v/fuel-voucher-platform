{
  "$schema": "https://docs.expo.dev/eas-schema/eas.json",
  "cli": {
    "version": ">= 5.0.0",
    "requireCommit": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://fuel-voucher-platform.onrender.com" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://fuel-voucher-platform.onrender.com" },
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "ascApiKeyPath": "./secrets/asc-api-key.p8"
      }
    }
  }
}
